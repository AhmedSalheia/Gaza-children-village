{
    "name": "gcv-data/documents",
    "description": "GCV DATA Documents module — document type catalogue, template versioning, safe placeholder resolution, PDF generation, and sequential document numbering.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "nwidart/laravel-modules": "^13.0",
        "mpdf/mpdf": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Documents\\": "app/",
            "Modules\\Documents\\Database\\Factories\\": "database/factories/",
            "Modules\\Documents\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Documents\\Tests\\": "tests/"
        }
    }
}

{
    "name": "gcv-data/reporting",
    "description": "GCV DATA Reporting module — permission-aware report families, Excel exports with formula-injection protection, and background job status tracking.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "nwidart/laravel-modules": "^13.0",
        "maatwebsite/excel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Reporting\\": "app/",
            "Modules\\Reporting\\Database\\Factories\\": "database/factories/",
            "Modules\\Reporting\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Reporting\\Tests\\": "tests/"
        }
    }
}

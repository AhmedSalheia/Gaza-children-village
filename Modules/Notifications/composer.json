    "type": "library",
    "require": {
        "php": "^8.3",
        "nwidart/laravel-modules": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Notifications\\": "app/",
            "Modules\\Notifications\\Database\\Factories\\": "database/factories/",

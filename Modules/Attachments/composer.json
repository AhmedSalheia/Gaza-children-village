    "type": "library",
    "require": {
        "php": "^8.3",
        "nwidart/laravel-modules": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Attachments\\": "app/",
            "Modules\\Attachments\\Database\\Factories\\": "database/factories/",
            "Modules\\Attachments\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
